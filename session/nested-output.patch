+static void request_host_mode(struct wlr_wl_output *output) {
+	if (!output->wlr_output.enabled || !output->logical_width || !output->logical_height) {
+		return;
+	}
+	int width = lround(output->logical_width * output->host_scale);
+	int height = lround(output->logical_height * output->host_scale);
+	if (width == output->wlr_output.width && height == output->wlr_output.height
+			&& output->wlr_output.scale == (float)output->host_scale) {
+		return;
+	}
+	struct wlr_output_state state;
+	wlr_output_state_init(&state);
+	wlr_output_state_set_custom_mode(&state, width, height, 0);
+	wlr_output_state_set_scale(&state, output->host_scale);
+	wlr_output_send_request_state(&output->wlr_output, &state);
+	wlr_output_state_finish(&state);
+}
+
+static void preferred_scale(void *data, struct wp_fractional_scale_v1 *fractional, uint32_t scale) {
+	struct wlr_wl_output *output = data;
+	output->host_scale = scale / 120.0;
+	request_host_mode(output);
+}
+
+static const struct wp_fractional_scale_v1_listener scale_listener = {
+	.preferred_scale = preferred_scale,
+};
+
+static int handle_activation(int fd, uint32_t mask, void *data) {
+	struct wlr_wl_output *output = data;
+	char token[4096];
+	ssize_t size = recv(fd, token, sizeof(token) - 1, MSG_DONTWAIT);
+	if (size > 0 && output->backend->activation_v1) {
+		token[size] = 0;
+		xdg_activation_v1_activate(output->backend->activation_v1, token, output->surface);
+		wl_display_flush(output->backend->remote_display);
+	}
+	return 0;
+}
