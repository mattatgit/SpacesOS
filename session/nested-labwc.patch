 static int
-handle_sigterm(int signal, void *data)
-{
-	struct wl_display *display = data;
-
+finish_close(void *display)
+{
 	wl_display_terminate(display);
 	return 0;
+}
+
+static int
+handle_sigterm(int signal, void *data)
+{
+	struct server *server = data;
+
+	/* Give the primary shell a chance to close its Wayland clients before
+	 * disconnecting their display. SIGCHLD completes the normal shutdown. */
+	if (server->primary_client_pid > 0 && kill(server->primary_client_pid, SIGTERM) == 0) {
+		struct wl_event_source *deadline = wl_event_loop_add_timer(
+			server->wl_event_loop, finish_close, server->wl_display);
+		if (deadline && wl_event_source_timer_update(deadline, 1500) == 0) {
+			return 0;
+		}
+	}
+	return finish_close(server->wl_display);
 }
 
