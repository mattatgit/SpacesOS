#!/usr/bin/env bash
set -euo pipefail
umask 077
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cache=${XDG_CACHE_HOME:-$HOME/.cache}/SpacesOS/messaging
version=$(cd "$repo" && sha256sum messaging/Cargo.* messaging/src/{main,core,account,service}.rs flake.lock | sha256sum | cut -d' ' -f1)
bin="$cache/$version/spaces-messaging"
case ${1:-} in
    serve)
        if [[ ! -x "$bin" ]]; then
            if [[ ${SPACES_NESTED:-} == 1 ]]; then
                echo '{"type":"unavailable","message":"My Devices is not set up in this temporary session."}'
            else
                echo '{"type":"unavailable","message":"Run scripts/chat setup in a terminal, then reopen the Sidebar."}'
            fi
            exit 1
        fi ;;
    setup|build) ;;
    *) echo 'Usage: scripts/chat {setup|build|serve}' >&2; exit 2 ;;
esac
# The installed login already provides Secret Service and the URL opener.
if [[ $1 == serve && -x "$bin" && ${SPACES_SESSION_MODE:-} == login ]] && command -v secret-tool >/dev/null; then
    exec "$bin" serve
fi
if [[ ${SPACES_MESSAGING_ENV:-} != 1 ]]; then
    exec nix --extra-experimental-features 'nix-command flakes' develop "path:$repo#messaging" --command "$repo/scripts/chat" "$@"
fi
if [[ ! -x "$bin" ]]; then
    target=${CARGO_TARGET_DIR:-$cache/build}
    cargo build --locked --manifest-path "$repo/messaging/Cargo.toml" --target-dir "$target" -j 6
    mkdir -p "$(dirname "$bin")"
    stage=$(mktemp "$bin.XXXXXXXX")
    trap 'rm -f -- "$stage"' EXIT
    install -m 700 "$target/debug/spaces-messaging" "$stage"
    mv -fT -- "$stage" "$bin"
fi
[[ $1 != build ]] || exit 0
exec "$bin" "$1"
