#!/usr/bin/env bash
set -euo pipefail
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
mode=${1:-nested}
if (( $# )); then shift; fi
case "$mode:$*" in
    nested:|nested:--disposable|login:) ;;
    *) echo 'Usage: spaces-session {nested [--disposable]|login}' >&2; exit 2 ;;
esac
if [[ ${SPACES_DOCK_DEVSHELL:-} != 1 ]]; then
    exec nix --extra-experimental-features 'nix-command flakes' develop "path:$repo" --command "$repo/scripts/spaces-session" "$mode" "$@"
fi
if [[ $mode == nested && -z ${SPACES_REDUCED_MOTION+x} && ${XDG_CURRENT_DESKTOP:-} == *GNOME* ]] &&
        [[ $(gsettings get org.gnome.desktop.interface enable-animations 2>/dev/null || true) == false ]]; then
    export SPACES_REDUCED_MOTION=1
fi
# Both entry points run the same shell and session configuration.
export SPACES_SESSION_QML="$repo/dock/session.qml" SPACES_SESSION_MODE="$mode"
export NIXOS_OZONE_WL=1 XDG_CURRENT_DESKTOP=Spaces XDG_SESSION_DESKTOP=Spaces
export XDG_SESSION_TYPE=wayland QT_QPA_PLATFORM=wayland GDK_BACKEND=wayland
export PATH="$repo/scripts:$PATH"
if [[ $mode == nested ]]; then
    exec python3 -B "$repo/session/nested.py" "$@"
fi
unset DISPLAY WAYLAND_DISPLAY WLR_BACKENDS SWAYSOCK I3SOCK XDG_ACTIVATION_TOKEN DESKTOP_STARTUP_ID SPACES_NESTED
exec labwc -C "$repo/session" -S spaces-shell-client
